<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>竞彩助手 · 数据看板</title>
<style>
:root{--bg:#0b0f17;--card:#141a28;--card2:#10141f;--border:#1e2638;--text:#e2e6f0;--dim:#5a6288;--dim2:#3d4566;
--green:#22c55e;--red:#ef4444;--yellow:#eab308;--blue:#3b82f6;--purple:#a78bfa;--pink:#f472b6;--cyan:#22d3ee}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--text);line-height:1.5;min-height:100vh;overflow-x:hidden}
.wrap{max-width:1280px;margin:0 auto;padding:0 20px 60px}
@media(max-width:820px){.wrap{padding:0 10px 40px}}
/* ===== 顶栏 ===== */
.top{position:sticky;top:0;z-index:50;background:rgba(11,15,23,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--border)}
.top-in{max-width:1280px;margin:0 auto;padding:12px 20px 0}
@media(max-width:820px){.top-in{padding:10px 10px 0}}
.brand{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.brand .logo{font-size:20px;font-weight:800;letter-spacing:.5px;background:linear-gradient(90deg,var(--yellow),var(--pink));-webkit-background-clip:text;background-clip:text;color:transparent}
.brand .sub{font-size:12px;color:var(--dim)}
.brand .grow{flex:1}
.brand .tbtn{margin-left:auto;padding-bottom:0}
/* 账态条 */
.stats{display:flex;margin-top:10px;background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;flex-wrap:wrap;cursor:pointer}
.stats:hover{border-color:var(--dim)}
.stats .caret{font-size:10px;color:var(--dim);padding:0 10px;align-self:center}
.stats .st{flex:1;min-width:110px;padding:10px 16px;border-right:1px solid var(--border);text-align:center}
.stats .st:last-child{border-right:none}
.stats .st .k{font-size:10px;color:var(--dim);letter-spacing:.5px}
.stats .st .v{font-size:18px;font-weight:800;margin-top:2px}
@media(max-width:820px){.stats .st{min-width:84px;padding:8px 6px}.stats .st .v{font-size:15px}}
.stats .st .v.green{color:var(--green)}.stats .st .v.red{color:var(--red)}.stats .st .v.yellow{color:var(--yellow)}.stats .st .v.blue{color:var(--blue)}.stats .st .v.purple{color:var(--purple)}
.goalbar{height:5px;background:var(--border);border-radius:3px;margin-top:10px;overflow:hidden;position:relative}
.goalbar div{height:100%;background:linear-gradient(90deg,var(--green),var(--yellow));border-radius:3px;transition:width .5s}
.goalbar span{position:absolute;right:0;top:-16px;font-size:10px;color:var(--dim)}
.tbtn{display:flex;gap:8px}
.btn{background:var(--card);border:1px solid var(--border);color:var(--dim);border-radius:8px;padding:6px 14px;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s}
.btn:hover{color:var(--text);border-color:var(--dim)}
.btn.x{background:transparent;border-color:transparent;color:var(--dim);font-size:14px;padding:4px 8px}
.btn.x:hover{color:var(--red)}
@media(max-width:820px){.btn{padding:5px 10px;font-size:11px}}
/* 弹窗 */
.mask{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:100;display:flex;align-items:center;justify-content:center;padding:20px}
.modal{background:var(--bg);border:1px solid var(--border);border-radius:14px;width:min(1000px,94vw);max-height:86vh;display:flex;flex-direction:column;overflow:hidden}
.modal-head{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border);font-weight:700}
.modal-body{overflow:auto;padding:16px}
.bets-drop{display:none;margin:8px 0 10px;background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.bets-drop.on{display:block}
.betlist-wrap{max-height:min(40vh,320px);overflow:auto}
.betlist{width:100%;border-collapse:collapse}
.betlist th{font-size:10px;color:var(--dim);font-weight:600;text-align:left;padding:6px 10px;background:var(--card2);position:sticky;top:0;white-space:nowrap}
.betlist td{padding:7px 10px;border-top:1px solid rgba(30,38,56,.6);font-size:12px;vertical-align:middle}
.betlist tr.open td{background:rgba(234,179,8,.06)}
.betlist .dt,.betlist .num{white-space:nowrap;color:var(--dim)}
.betlist .num{color:var(--blue);font-weight:700}
.betlist .leg{color:var(--cyan)}
.betlist .amt{white-space:nowrap;color:var(--text);font-weight:700}
.bst{font-size:10px;padding:1px 8px;border-radius:6px;font-weight:700;white-space:nowrap}
.bst.open{background:rgba(234,179,8,.15);color:var(--yellow)}
.bst.win{background:rgba(34,197,94,.15);color:var(--green)}
.bst.lose{background:rgba(239,68,68,.15);color:var(--red)}
.bst.void{background:rgba(255,255,255,.08);color:var(--dim)}
.srcerr{margin:10px 0 0;padding:8px 12px;border:1px solid var(--red);background:rgba(239,68,68,.1);border-radius:8px;color:var(--red);font-size:12px}
/* ===== 每日列表 ===== */
.daynav{display:flex;align-items:center;gap:10px;margin:18px 0 12px}
.daynav .navbtn{background:var(--card);border:1px solid var(--border);color:var(--dim);border-radius:8px;width:32px;height:32px;cursor:pointer;font-size:15px;line-height:1;flex:none}
.daynav .navbtn:hover{color:var(--text);border-color:var(--dim)}
.chips{display:flex;gap:6px;overflow-x:auto;scrollbar-width:thin;flex:1;padding-bottom:4px}
.chip{flex:none;padding:5px 12px;border-radius:8px;background:var(--card);border:1px solid var(--border);color:var(--dim);font-size:12px;cursor:pointer;transition:all .15s;text-align:center}
.chip b{display:block;font-size:15px;color:var(--text);line-height:1.3}
.chip:hover{border-color:var(--dim)}
.chip.on{background:var(--blue);border-color:var(--blue);color:#fff}
.chip.on b{color:#fff}
.chip .cnt{font-size:9px;color:var(--dim)}
.chip.on .cnt{color:rgba(255,255,255,.7)}
/* 当日统计条 */
.daystat{display:flex;gap:14px;flex-wrap:wrap;align-items:center;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:10px 16px;margin-bottom:14px;font-size:12px}
.daystat .it{color:var(--dim)}
.daystat .it b{color:var(--text);font-size:14px}
.daystat .best a{color:var(--yellow);text-decoration:none;cursor:pointer}
.daystat .best a:hover{text-decoration:underline}
@media(max-width:820px){.daystat{gap:8px;font-size:11px;padding:8px 10px}.daystat .it b{font-size:13px}}
/* 表格 */
.tbl-wrap{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.legend{font-size:11px;color:var(--dim);padding:10px 14px;border-top:1px solid var(--border);line-height:1.7}
table{width:100%;border-collapse:collapse}
thead th{font-size:11px;color:var(--dim);font-weight:600;letter-spacing:.5px;text-align:left;padding:10px 12px;border-bottom:1px solid var(--border);background:var(--card2);white-space:nowrap}
tbody td{padding:9px 12px;border-bottom:1px solid rgba(30,38,56,.6);font-size:13px;vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr.mrow{cursor:pointer;transition:background .12s}
tbody tr.mrow:hover{background:rgba(30,38,56,.35)}
tbody tr.mrow.open{background:rgba(59,130,246,.08)}
.num{font-weight:700;color:var(--blue);white-space:nowrap}
.league{font-size:11px;color:var(--dim);white-space:nowrap}
.teams{font-weight:700;white-space:nowrap}
.teams .vs{color:var(--dim);font-weight:400;margin:0 3px}
.time{color:var(--dim);font-size:12px;white-space:nowrap}
.dir{font-size:13px;color:var(--cyan);line-height:1.35}
.dir b{font-weight:700;margin-right:10px}
.dir .od{color:var(--text);font-weight:700}
.drop{font-size:11px;color:var(--green);margin-top:4px;letter-spacing:.04em}
td.dirtd{padding-left:16px;padding-right:20px;min-width:118px}
td.dirtd{padding-left:16px;padding-right:20px;min-width:118px}
.scr-cell{display:flex;align-items:center;gap:8px}
.scr-num{font-size:19px;font-weight:800;width:36px;text-align:center}
.scr-dim{width:54px;display:flex;flex-direction:column;gap:1px}
.scr-dim i{height:3px;border-radius:2px;background:var(--border);display:block;overflow:hidden}
.scr-dim i b{display:block;height:100%;border-radius:2px}
.scr-dim span{font-size:8px;color:var(--dim);text-align:center;margin-top:1px}
.res{font-size:12px;white-space:nowrap;color:var(--dim)}
.res.hit{color:var(--green);font-weight:700}
.res .yh{display:inline-block;margin-left:4px;padding:0 5px;border-radius:4px;background:rgba(234,179,8,.2);color:var(--yellow);font-size:10px;font-weight:800}
/* 展开详情：单列压紧，不留空格 */
tr.detail>td{padding:0;background:var(--card2)}
.detail-box{padding:10px 14px 12px;display:flex;flex-direction:column;gap:8px}
.odds-strip{display:flex;flex-direction:column;gap:6px}
.odds-row{display:grid;grid-template-columns:64px 1fr;gap:8px;align-items:center}
.or-name{font-size:11px;color:var(--dim);font-weight:700;white-space:nowrap}
.odds3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px}
.ocell{background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:5px 8px;text-align:center}
.ocell .lbl{font-size:10px;color:var(--dim)}
.ocell .now{font-size:15px;font-weight:800;line-height:1.2}
.ocell .base{font-size:10px;color:var(--dim)}
.ocell .base .hl{color:var(--green);font-weight:700}
.ocell .base .hl-up{color:var(--red);font-weight:700}
.dims{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}
@media(max-width:820px){.dims{grid-template-columns:repeat(3,1fr)}.odds-row{grid-template-columns:1fr}}
.dm{background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:6px 8px}
.dm .dk{font-size:10px;color:var(--dim);white-space:nowrap}
.dm .dv{font-size:14px;font-weight:800}
.dm .bar{height:3px;background:var(--border);border-radius:2px;margin-top:4px;overflow:hidden}
.dm .bar i{display:block;height:100%;border-radius:2px}
.vstrip{background:var(--bg);border:1px solid var(--purple);border-radius:8px;padding:8px 10px;font-size:12px;line-height:1.55}
.vstrip .vh{display:flex;justify-content:space-between;gap:8px;font-weight:700;margin-bottom:2px}
.vstrip .anal{color:#b9c0d4}
.vstrip .hook{color:var(--yellow);font-size:11px;margin-top:4px}
.meta-line{font-size:12px;color:var(--dim)}
.meta-line b{color:var(--text)}
/* ===== 日记页 ===== */
.di-grid{display:grid;grid-template-columns:340px 1fr;gap:20px;margin-top:16px}
@media(max-width:820px){.di-grid{grid-template-columns:1fr;gap:12px}}
.cal{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px;height:fit-content}
.cal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.cal-header .ym{font-size:15px;font-weight:700}
.cal-header .nav{display:flex;gap:8px}
.cal-header button{background:var(--bg);border:1px solid var(--border);color:var(--dim);border-radius:6px;width:28px;height:28px;cursor:pointer;font-size:14px;line-height:1}
.cal-header button:hover{color:var(--text);border-color:var(--dim)}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.cal-grid .dow{font-size:10px;color:var(--dim);text-align:center;padding:5px 0}
.cal-grid .day{min-height:34px;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;font-size:13px;position:relative;transition:all .15s;border:1px solid transparent;padding:3px 0}
.cal-grid .day.empty{cursor:default}
.cal-grid .day:hover:not(.empty){background:var(--border)}
.cal-grid .day.on{background:var(--blue);color:#fff;font-weight:700}
.cal-grid .day .dot{width:4px;height:4px;border-radius:50%;margin-top:3px}
.cal-grid .day .dot.g{background:var(--green)}.cal-grid .day .dot.r{background:var(--red)}.cal-grid .day .dot.y{background:var(--yellow)}
.diary{padding:4px 0 20px;min-width:0}
.diary-head{display:flex;align-items:center;gap:16px;margin-bottom:8px}
.diary-head .date-big{font-size:38px;font-weight:800;letter-spacing:-1px;line-height:1}
.diary-head .date-sub{color:var(--dim);font-size:13px;padding-top:6px}
.diary-title{font-size:18px;font-weight:700;color:var(--yellow);margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--border)}
.entry{position:relative;padding:0 0 22px 26px;border-left:2px solid var(--border)}
.entry:last-child{border-left-color:transparent;padding-bottom:6px}
.entry::before{content:'';position:absolute;left:-7px;top:4px;width:12px;height:12px;border-radius:50%;background:var(--bg);border:2px solid var(--dim)}
.entry[data-type="mistake"]::before{border-color:var(--red);background:var(--red)}
.entry[data-type="lesson"]::before{border-color:var(--yellow);background:var(--yellow)}
.entry[data-type="action"]::before{border-color:var(--green);background:var(--green)}
.entry[data-type="analysis"]::before{border-color:var(--blue);background:var(--blue)}
.entry .time{font-size:11px;color:var(--dim);font-weight:600;letter-spacing:.5px;margin-bottom:6px;display:flex;align-items:center;gap:8px}
.entry .content{font-size:14px;line-height:1.75;color:#cdd3e3;white-space:pre-line;overflow-wrap:break-word;word-break:break-word}
.entry .content b{color:var(--text)}
.entry .content em{font-style:normal;color:var(--yellow)}
.tag{display:inline-block;padding:1px 8px;border-radius:4px;font-size:10px;font-weight:600;letter-spacing:.3px}
.tag.thought{background:rgba(59,130,246,.15);color:var(--blue)}
.tag.mistake{background:rgba(239,68,68,.15);color:var(--red)}
.tag.lesson{background:rgba(234,179,8,.15);color:var(--yellow)}
.tag.action{background:rgba(34,197,94,.15);color:var(--green)}
.tag.analysis{background:rgba(167,139,250,.15);color:var(--purple)}
.day-bets{display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap}
.day-bet{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:12px 14px;font-size:12px;min-width:200px;flex:1}
@media(max-width:820px){.day-bet{min-width:0;padding:10px 12px;font-size:11px;flex:1 1 100%}}
.day-bet .b-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.day-bet .b-id{font-weight:700;font-size:13px}
.day-bet .b-status{font-size:10px;padding:2px 8px;border-radius:6px;font-weight:600}
.day-bet .b-status.win{background:rgba(34,197,94,.15);color:var(--green)}
.day-bet .b-status.lose{background:rgba(239,68,68,.15);color:var(--red)}
.day-bet .b-status.active{background:rgba(234,179,8,.15);color:var(--yellow)}
.b-legs{color:var(--dim);line-height:1.6}
.b-odd{margin-top:8px;color:var(--text);font-weight:600}
.empty{background:var(--card);border:1px dashed var(--border);border-radius:16px;padding:40px;text-align:center;color:var(--dim);font-size:13px}
@media(max-width:820px){.empty{padding:24px;font-size:12px}}
.footer{text-align:center;padding:18px;font-size:11px;color:var(--dim);border-top:1px solid var(--border);margin-top:20px}
.link{color:var(--blue);text-decoration:none;font-size:12px;cursor:pointer}
.hidden{display:none!important}
#modal-body{overflow:auto;padding:16px}
</style>
</head>
<body>
<div class="top">
  <div class="top-in">
    <div class="brand">
      <div class="logo">🏆 竞彩助手</div>
      <div class="sub">官方数据 · 全表评分 · 投注台账</div>
      <div class="grow"></div>
      <div class="tbtn">
        <button class="btn" onclick="openModal('diary')">📖 日记</button>
        <button class="btn" onclick="openModal('up')">🔬 自我升级</button>
      </div>
    </div>
    <div class="stats" id="stats" onclick="toggleBets()" title="查看从¥1000起的实单"></div>
    <div class="bets-drop" id="betstop"></div>
    <div class="goalbar"><div id="goalpct"></div><span id="goalnote"></span></div>
  </div>
</div>

<!-- 弹窗（日记 / 自我升级） -->
<div id="modal-mask" class="mask hidden" onclick="closeModal(event)">
  <div class="modal" id="modal">
    <div class="modal-head"><span id="modal-title">📖 日记</span><button class="btn x" onclick="closeModal()">✕</button></div>
    <div id="modal-body"></div>
  </div>
</div>

<div class="wrap">
  <div id="srcerr" class="srcerr hidden"></div>

  <div id="view-day">
    <div class="daynav">
      <button class="navbtn" onclick="dayMove(-1)">‹</button>
      <div class="chips" id="daychips"></div>
      <button class="navbtn" onclick="dayMove(1)">›</button>
    </div>
    <div class="daystat" id="daystat"></div>
    <div class="tbl-wrap" id="daytable"><div class="empty">加载中…</div></div>
  </div>
</div>

<div class="footer">竞彩助手 · 数据看板 v2.0</div>

<script>
const $ = s => document.querySelector(s);
const r2 = n => Math.round((Number(n) || 0) * 100) / 100;
const esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const BN = { hammer:'🔨重锤', real:'✅实单', cand:'⏳候选', weak:'👀弱', drop:'❌放弃' };
const bandCls = t => t >= 90 ? 'hammer' : t >= 80 ? 'real' : t >= 60 ? 'cand' : t >= 40 ? 'weak' : 'drop';

let S = { summary:{}, days:[], journals:[], cur:null, day:{}, open:new Set(), scoreDay:false, calY:2026, calM:9, betsOpen:false };

async function load() {
  const [sum, days, diary] = await Promise.all([
    fetch('/api/summary').then(x => x.ok ? x.json() : {}).catch(() => ({})),
    fetch('/api/days').then(x => x.ok ? x.json() : { days: [] }).catch(() => ({ days: [] })),
    fetch('/api/diary').then(x => x.ok ? x.json() : { journals: [] }).catch(() => ({ journals: [] })),
  ]);
  S.summary = sum;
  S.days = (days.days || []).sort((a, b) => a.date < b.date ? -1 : 1);
  S.journals = (diary.journals || []).sort((a, b) => a.date < b.date ? -1 : 1);
  S.cur = S.days[S.days.length - 1]?.date || '';
  if (!S.cur && S.journals.length) S.cur = S.journals[S.journals.length - 1].date;
  renderStats();
  renderBetstop();
  if (S.days.length) await goDay(S.cur);
  else $('#daytable').innerHTML = '<div class="empty">暂无场次数据</div>';
  syncStatus();
}

/* 展示同步：只读新评分文件，不在浏览器里打分 */
async function syncStatus() {
  const st = await fetch('/api/score-status').then(x => x.ok ? x.json() : null).catch(() => null);
  const box = $('#srcerr');
  if (!box) return;
  if (st && st.ok === false && st.errors && st.errors.length) {
    box.classList.remove('hidden');
    box.textContent = '信息源错误：' + st.errors.map(e => (e.source || '') + ' ' + (e.message || '')).join('；');
  } else box.classList.add('hidden');
}
async function syncView() {
  if (document.hidden || !S.cur) return;
  const [sum, days] = await Promise.all([
    fetch('/api/summary').then(x => x.ok ? x.json() : S.summary).catch(() => S.summary),
    fetch('/api/days').then(x => x.ok ? x.json() : { days: S.days }).catch(() => ({ days: S.days })),
  ]);
  S.summary = sum;
  S.days = (days.days || S.days);
  renderStats();
  renderBetstop();
  const keep = [...S.open];
  await goDay(S.cur);
  keep.forEach(n => S.open.add(n));
  renderTable();
  syncStatus();
}
setInterval(syncView, 120000);

/* ===== 注单（置顶区块）===== */
function betDate(b) {
  const s = b.placedAt || '';
  const m = String(s).match(/(\d{4})-(\d{2})-(\d{2})/);
  return m ? `${m[2]}-${m[3]}` : '';
}
function betNums(b) {
  return (b.legs || []).map(l => l.matchNum || '').filter(Boolean).join('×') || '—';
}
function betWhat(b) {
  return (b.legs || []).map(l => {
    const p = String(l.pick || '').replace(/\s*\([^)]*\)/g, '').trim();
    const vs = [l.home, l.away].filter(Boolean).join('vs');
    if (!p) return vs;
    if (vs && l.home && !p.includes(l.home) && !p.includes(l.away)) return vs + ' ' + p;
    return p;
  }).join(' × ');
}
function toggleBets() {
  S.betsOpen = !S.betsOpen;
  renderStats();
  renderBetstop();
}
function renderBetstop() {
  const el = $('#betstop');
  if (!el) return;
  el.classList.toggle('on', !!S.betsOpen);
  if (!S.betsOpen) { el.innerHTML = ''; return; }
  const bets = (S.summary.bets || []).filter(b =>
    b.betId != null && b.status !== 'void' && b.status !== 'cancelled'
  ).sort((a, b) => (b.betId || 0) - (a.betId || 0));
  if (!bets.length) { el.innerHTML = '<div class="empty" style="border:none;padding:12px">暂无实单</div>'; return; }
  const rows = bets.map(b => {
    let cls = 'open', txt = '在途';
    if (b.status !== 'open') {
      const p = Number(b.profit);
      if (p > 0) { cls = 'win'; txt = '赢 +' + r2(p); }
      else if (p < 0) { cls = 'lose'; txt = '输 ' + r2(p); }
      else { cls = 'void'; txt = '走'; }
    }
    return `<tr class="${cls}"><td class="dt">${esc(betDate(b))}</td><td class="num">${esc(betNums(b))}</td><td class="leg">${esc(betWhat(b))}</td><td class="amt">${r2(b.stake)}</td><td><span class="bst ${cls}">${txt}</span></td></tr>`;
  }).join('');
  el.innerHTML = `<div class="betlist-wrap"><table class="betlist"><thead><tr><th>日期</th><th>场次</th><th>买的</th><th>金额</th><th>结果</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}

/* ===== 顶栏账态 ===== */
function renderStats() {
  const L = S.summary.ledger || {};
  const bank = S.summary.bankroll || {};
  const cashV = L.cash ?? bank.cash ?? 0;
  const start = L.startBankroll || 1000;
  const profit = L.settledProfit ?? 0;
  const inPlay = (L.inPlay || []).length;
  const totalPortfolio = cashV + (L.inPlayAmount ?? 0);
  const pct = Math.max(0, Math.min(100, totalPortfolio / 10000 * 100));
  $('#stats').innerHTML = `
    <div class="st"><div class="k">本 金</div><div class="v blue">¥${start}</div></div>
    <div class="st"><div class="k">现金可用</div><div class="v ${cashV >= start ? 'green' : 'red'}">¥${r2(cashV)}</div></div>
    <div class="st"><div class="k">已结算盈亏</div><div class="v ${profit >= 0 ? 'green' : 'red'}">${profit >= 0 ? '+' : ''}${r2(profit)}</div></div>
    <div class="st"><div class="k">在途注单</div><div class="v yellow">${inPlay} 单</div></div>
    <div class="st"><div class="k">体系总资产</div><div class="v purple">¥${r2(totalPortfolio)}</div></div>
    <span class="caret">${S.betsOpen ? '▲' : '▼'}</span>`;
  $('#goalpct').style.width = pct + '%';
  $('#goalnote').textContent = `距 ¥10000 差 ${(10000 - totalPortfolio).toFixed(0)} · ${pct.toFixed(1)}%`;
}

/* ===== 弹窗（日记 / 自我升级）===== */
function openModal(kind) {
  const mask = $('#modal-mask');
  $('#modal-title').textContent = kind === 'diary' ? '📖 日记' : '🔬 自我升级';
  if (kind === 'diary') {
    $('#modal-body').innerHTML = `<div class="di-grid">
      <div class="cal"><div class="cal-header"><div class="ym" id="cal-ym"></div><div class="nav"><button onclick="calMove(-1)">‹</button><button onclick="calMove(1)">›</button></div></div><div class="cal-grid" id="cal-grid"></div></div>
      <div class="diary" id="diary"></div>
    </div>`;
    mask.classList.remove('hidden');
    renderCal();
    renderDiary();
  } else {
    $('#modal-body').innerHTML = `<iframe src="self-upgrade.html" style="width:100%;height:70vh;border:1px solid var(--border);border-radius:10px;background:var(--bg)"></iframe>`;
    mask.classList.remove('hidden');
  }
}
function closeModal(e) {
  if (e && e.target !== e.currentTarget) return;
  $('#modal-mask').classList.add('hidden');
}

/* ===== 每日列表 ===== */
function renderChips() {
  $('#daychips').innerHTML = S.days.map(d => {
    const day = d.date.slice(5).replace('-', '/');
    const on = d.date === S.cur ? ' on' : '';
    return `<div class="chip${on}" onclick="goDay('${d.date}')"><b>${day}</b><span class="cnt">${d.matches}场</span></div>`;
  }).join('');
  const el = document.querySelector('.chip.on');
  if (el) el.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
}

function dayMove(d) {
  const i = S.days.findIndex(x => x.date === S.cur);
  const j = Math.max(0, Math.min(S.days.length - 1, i + d));
  if (i !== j) goDay(S.days[j].date);
}

async function goDay(date) {
  S.cur = date;
  S.open = new Set();
  // 评分只显示"最新一天"（当天）；历史日只出盘口不评分
  S.scoreDay = !!S.days.length && date === S.days[S.days.length - 1].date && !!loadDayScoreExists(date);
  renderChips();
  const data = await fetch('/api/day/' + date).then(x => x.ok ? x.json() : null).catch(() => null);
  if (!data) { $('#daytable').innerHTML = '<div class="empty">该日无数据</div>'; $('#daystat').innerHTML=''; return; }
  S.day = data;
  renderDayStat();
  renderTable();
}
function loadDayScoreExists(date) {
  const d = S.days.find(x => x.date === date);
  return !!(d && d.scoreFile);
}

function renderDayStat() {
  const s = S.day.summary || {};
  const at = S.day.scoreGeneratedAt ? new Date(S.day.scoreGeneratedAt) : null;
  const atTxt = at && !isNaN(at) ? at.toLocaleString('zh-CN', { hour12: false }) : '';
  $('#daystat').innerHTML = `
    <span class="it">总场次 <b>${s.total}</b></span>
    ${S.scoreDay ? `<span class="it">已评分 <b>${s.scored}</b>${S.day.scoreVersion ? ' · ' + S.day.scoreVersion : ''}</span>` : '<span class="it">历史盘口 · 不评分</span>'}
    ${S.scoreDay && s.best ? `<span class="best">最高 <a onclick="toggleRow('${s.best.num}')">${s.best.num} ${s.best.home}-${s.best.away} · ${s.best.total}分</a></span>` : ''}
    ${S.scoreDay ? `<span class="it">评分准确率 <b style="color:${s.accPct == null ? 'var(--dim)' : s.accPct >= 60 ? 'var(--green)' : 'var(--yellow)'}">${s.accDone ? s.accHit + '/' + s.accDone + ' ' + s.accPct + '%' : '待开奖'}</b>${s.yellowDone ? ` · 候选 ${s.yellowHit}/${s.yellowDone}` : ''}</span>` : ''}
    <span class="it">虚拟 <b style="color:var(--yellow)">${s.virtualOpen}在途</b> / <b>${s.virtualEnd}已结</b></span>
    ${atTxt ? `<span class="it">评分更新 <b>${atTxt}</b></span>` : ''}`;
}

function renderTable() {
  const scoreDay = S.scoreDay;
  const head = scoreDay ? ['场次','联赛','对阵','时间','方向@赔率','评分','赛果'] : ['场次','联赛','对阵','时间','盘口'];
  const rows = (S.day.table || []);
  if (!rows.length) { $('#daytable').innerHTML = '<div class="empty">当日无竞彩场次</div>'; return; }
  let h = `<table><thead><tr>${head.map(x => `<th>${x}</th>`).join('')}</tr></thead><tbody>`;
  for (const row of rows) h += rowHtml(row);
  h += '</tbody></table>';
  if (scoreDay) h += `<div class="legend">评分 = 当日全表信息值（点击行展开看降水/模型/维度明细）</div>`;
  $('#daytable').innerHTML = h;
}

function rowHtml(row) {
  const m = row.match || {}, sc = row.score || null, v = row.virtual || null;
  const isOpen = S.open.has(row.num);
  const t = sc ? sc.total : null;
  const had = m.had || {}, hhad = m.hhad || {};
  const dirHtml = (S.scoreDay && sc && sc.dir)
    ? `<div class="dir"><b>${esc(shortDir(sc))}</b><span class="od">${sc.odds}</span></div>${dropLine(sc)}`
    : (had.h || hhad.h)
      ? `<div class="dir"><b>主${esc(had.h || '—')}</b><span class="od">客${esc(had.a || '—')}</span></div>${hhad.goalLine ? `<div class="drop">让${esc(hhad.goalLine)}</div>` : ''}`
      : '<span class="drop" style="color:var(--dim2)">未开盘</span>';
  const cel = scoreCell(sc, S.scoreDay);
  return `
    <tr class="mrow ${isOpen ? 'open' : ''}" onclick="toggleRow('${row.num}')">
      <td class="num">${esc(row.num)}</td>
      <td class="league">${esc(m.league || '')}</td>
      <td class="teams">${esc(m.home || '')}<span class="vs">vs</span>${esc(m.away || '')}</td>
      <td class="time">${esc((m.matchTime || '').slice(0, 5))}</td>
      <td class="dirtd">${dirHtml}</td>
      ${S.scoreDay ? `<td>${cel}</td>` : ''}
      ${S.scoreDay ? `<td>${hitHtml(row)}</td>` : ''}
    </tr>${isOpen ? detailRow(row) : ''}`;
}

/* 评分单元格：今日显示总分+维度条；历史日不显示 */
function shortDir(sc) { return (sc && sc.dir) || ''; }
function dropLine(sc) {
  if (typeof sc.dropAmt === 'number') {
    if (sc.dropAmt > 0) return `<div class="drop">💧 ${sc.dropAmt.toFixed(2)}</div>`;
    if (sc.dropAmt < 0) return `<div class="drop" style="color:var(--dim)">↑ ${Math.abs(sc.dropAmt).toFixed(2)}</div>`;
    return '<div class="drop" style="color:var(--dim)">静</div>';
  }
  if (!sc.dropNote) return '';
  return `<div class="drop">${escapeHtmlC(String(sc.dropNote).replace(/\(H[^)]*\)/, ''))}</div>`;
}
function hitHtml(row) {
  const r = row.result;
  if (!r) return '<span class="res">—</span>';
  return `<span class="res${r.hit ? ' hit' : ''}">${esc(r.text)}${r.yellowHit ? '<span class="yh">候选✓</span>' : ''}</span>`;
}
function scoreCell(sc, scoreDay) {
  if (!scoreDay || !sc || sc.total == null) return '';
  const t = sc.total;
  const dm = dims(sc);
  const cols = ['var(--green)','var(--blue)','var(--purple)','var(--yellow)','var(--red)','var(--cyan)'];
  const dimBar = `<div class="scr-dim">${dm.slice(0,3).map((d,i)=>`<i><b style="width:${Math.min(100,d.val/d.max*100)}%;background:${cols[i]}"></b></i>`).join('')}<span>${dm.map(d=>d.val).join('/')}</span></div>`;
  return `<div class="scr-cell"><div class="scr-num" style="color:${t>=90?'var(--purple)':t>=80?'var(--green)':t>=60?'var(--yellow)':'var(--dim)'}">${t}</div>${dimBar}</div>`;
}

function detailRow(row) {
  const m = row.match || {}, sc = row.score || null, v = row.virtual || null;
  const odds = (m.had || m.hhad)
    ? `<div class="odds-strip">${oddsRow('胜平负', m.had, sc && sc.base && sc.base.had)}${oddsRow('让球' + (m.hhad && m.hhad.goalLine ? ' ' + m.hhad.goalLine : ''), m.hhad, sc && sc.base && sc.base.hhad)}</div>`
    : '';
  let dimHtml = '';
  if (S.scoreDay && sc && sc.total != null) {
    const colors = ['var(--green)','var(--blue)','var(--purple)','var(--yellow)','var(--red)','var(--cyan)'];
    const dm = dims(sc);
    dimHtml = `<div class="dims">${dm.map((d, i) => `
      <div class="dm"><div class="dk">${d.name}</div><div class="dv">${d.val}/${d.max}</div>
      <div class="bar"><i style="width:${Math.min(100, d.val / d.max * 100)}%;background:${colors[i]}"></i></div></div>`).join('')}</div>`;
  }
  let vb = '';
  if (v) {
    const st = v.status;
    const stTxt = st === 'win' ? '中' : st === 'lose' ? '败' : st === 'open' ? '在途' : (st || '');
    vb = `<div class="vstrip"><div class="vh"><span>虚拟 ${esc(v.id || '')} · ${esc(v.pick || '')}</span><span style="color:${st === 'win' ? 'var(--green)' : st === 'lose' ? 'var(--red)' : 'var(--yellow)'}">${stTxt}${v.result ? ' · ' + esc(v.result) : ''}</span></div>
      <div class="anal">${esc(v.myView || '')}${v.analysis ? ' · ' + esc(v.analysis) : ''}</div>
      ${v.reviewHook ? `<div class="hook">${esc(v.reviewHook)}</div>` : ''}</div>`;
  }
  const meta = `<div class="meta-line">${esc(row.num)} · ${esc(m.league || '—')} · ${esc(m.matchDate || '')} ${esc((m.matchTime || '').slice(0, 5))}${sc && sc.matchId ? ' · ' + sc.matchId : ''}${S.scoreDay && sc ? ` · <b style="color:var(--cyan)">${esc(sc.dir)}@${sc.odds}</b> ${esc(sc.dropNote || '')} · ${sc.total}分 ${BN[bandCls(sc.total)] || ''}` : ''}</div>`;
  const col = S.scoreDay ? 7 : 5;
  return `<tr class="detail"><td colspan="${col}"><div class="detail-box">${meta}${odds}${dimHtml}${vb}</div></td></tr>`;
}

function toggleRow(num) {
  if (S.open.has(num)) S.open.delete(num); else S.open.add(num);
  renderTable();
}

function oddsRow(name, now, base) {
  if (!now) return '';
  const cells = [['主', now.h, 'h'], ['平', now.d, 'd'], ['客', now.a, 'a']];
  let row = '<div class="odds3">';
  for (const [lbl, v, k] of cells) {
    const bv = base && base[k];
    let baseHtml = '';
    if (bv && v) {
      const d = +(parseFloat(bv) - parseFloat(v)).toFixed(2);
      if (d > 0) baseHtml = `<div class="base">${esc(bv)} <b class="hl">▼${d}</b></div>`;
      else if (d < 0) baseHtml = `<div class="base">${esc(bv)} <b class="hl-up">▲${Math.abs(d)}</b></div>`;
    }
    row += `<div class="ocell"><div class="lbl">${lbl}</div><div class="now">${esc(v || '—')}</div>${baseHtml}</div>`;
  }
  row += '</div>';
  return `<div class="odds-row"><span class="or-name">${esc(name)}</span>${row}</div>`;
}

/* ===== 日记页 ===== */
function calMove(d) {
  S.calM += d;
  if (S.calM < 1) { S.calM = 12; S.calY--; }
  if (S.calM > 12) { S.calM = 1; S.calY++; }
  renderCal();
}
function renderCal() {
  if (!$('#cal-ym') || !$('#cal-grid')) return;
  const y = S.calY, m = S.calM;
  $('#cal-ym').textContent = `${y}年 ${m}月`;
  const first = new Date(y, m - 1, 1).getDay();
  const days = new Date(y, m, 0).getDate();
  const dow = ['日', '一', '二', '三', '四', '五', '六'];
  let h = dow.map(d => `<div class="dow">${d}</div>`).join('');
  for (let i = 0; i < first; i++) h += '<div class="day empty"></div>';
  for (let d = 1; d <= days; d++) {
    const ds = `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    const j = S.journals.find(x => x.date === ds);
    const dot = j ? (j.bankroll && j.bankroll.change > 0 ? 'g' : j.bankroll && j.bankroll.change < 0 ? 'r' : 'y') : '';
    h += `<div class="day ${j ? 'on' : ''}" onclick="selectDiary('${ds}')">${d}${dot ? `<div class="dot ${dot}"></div>` : ''}</div>`;
  }
  $('#cal-grid').innerHTML = h;
}
function selectDiary(ds) {
  // 有日记则展示该日，无则跳到有日记的最近一日
  const j = S.journals.find(x => x.date === ds);
  if (j) { renderDiary(ds); return; }
  const prev = [...S.journals].reverse().find(x => x.date < ds);
  const next = S.journals.find(x => x.date > ds);
  const target = prev || next;
  if (target) { renderDiary(target.date); alert('该日无日记，已跳至 ' + target.date); }
}
function renderDiary(date) {
  const el = $('#diary');
  if (!el) return;
  const target = date || (S.journals[S.journals.length - 1]?.date || '');
  const j = S.journals.find(x => x.date === target);
  if (!j) { el.innerHTML = '<div class="empty">还没有日记</div>'; return; }
  const typeLabel = { thought: '思考', mistake: '教训', lesson: '心得', action: '行动', analysis: '分析', settle: '结算', summary: '汇总', decision: '决策' };
  let bets = '';
  if (j.bets && j.bets.length) {
    bets = `<div class="day-bets">${j.bets.map(b => {
      const st = b.status === 'loss' ? 'lose' : b.status === 'win' ? 'win' : 'active';
      const stTxt = b.status === 'loss' ? '❌ 输' : b.status === 'win' ? '✅ 赢' : b.status === 'void' ? '⚪ 无效' : '🔄 在途';
      const ret = b.return != null ? ` → ${r2(b.return)}` : '';
      const profit = b.return != null ? r2(b.return - b.stake) : null;
      return `<div class="day-bet"><div class="b-head"><span class="b-id">bet #${esc(b.id)}</span><span class="b-status ${st}">${stTxt}</span></div><div class="b-legs">${esc(b.legs || '')}</div><div class="b-odd">投${r2(b.stake)}元${ret}${profit != null ? ` · 盈亏 ${profit >= 0 ? '+' : ''}${profit}` : ''}</div></div>`;
    }).join('')}</div>`;
  }
  let content = '';
  (j.content || []).forEach(e => {
    content += `<div class="entry" data-type="${e.type}">
      <div class="time"><span class="tag ${e.type}">${typeLabel[e.type] || e.type}</span> · ${esc(e.time)}</div>
      <div class="content">${md(e.text)}</div>
    </div>`;
  });
  el.innerHTML = `<div class="diary-head">
      <div class="date-big">${j.date.slice(5)}</div>
      <div class="date-sub">${esc(j.date)}<br>盈亏 ${j.bankroll && j.bankroll.change >= 0 ? '+' : ''}${r2(((j.bankroll || {}).change) || 0)}元<br>${esc(j.mood || '')}</div>
    </div>
    <div class="diary-title">${esc(j.title)}</div>
    ${bets}${content}`;
}

function md(s) {
  if (!s) return '';
  let t = esc(s);
  t = t.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>')
    .replace(/`(.+?)`/g, '<code style="background:var(--bg);padding:1px 6px;border-radius:4px;font-size:12px">$1</code>');
  return t;
}

/* html 转义（用于已含 html 的 dropNote 之外字段） */
function escapeHtmlC(s) { return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

/* 评分六维分解（与 score_sat_full.cjs 计算一致，dropSc 未落盘需反推） */
function dims(sc) {
  const dirPt = sc.confirm === 2 ? 8 : 4;
  const dropPart = sc.total - dirPt - (sc.model || 0) - (sc.history || 0) - (sc.risk || 0) - (sc.value || 0);
  return [
    { name: '降水/变盘', val: dropPart, max: 35 },
    { name: '方向确认', val: dirPt, max: 8 },
    { name: '模型命中', val: sc.model || 0, max: 20 },
    { name: '历史验证', val: sc.history || 0, max: 10 },
    { name: '风险排除', val: sc.risk || 0, max: 10 },
    { name: '赔率价值', val: sc.value || 0, max: 5 },
  ];
}

load();
</script>
</body>
</html>