  clock:'<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2.2"/>',
  star:'<path d="M12 3.6l2.5 5.1 5.6.8-4.05 4 1 5.6L12 16.4l-5.05 2.7 1-5.6-4.05-4 5.6-.8z"/>',
