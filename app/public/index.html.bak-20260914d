const daysSigOf = ds => JSON.stringify((ds || []).map(d => [d.date, d.matches, d.scoreFile]));
const sumSigOf = sum => JSON.stringify({
  c: (sum.ledger || {}).cash, p: (sum.ledger || {}).settledProfit,
  b: (sum.bets || []).map(x => [x.betId, x.status, x.profit]),
});
const tableSigOf = data => JSON.stringify(((data && data.table) || []).map(r => [
  r.num, r.score && r.score.total, r.result && r.result.text,
  r.bets && r.bets.map(b => [b.betId, b.status, b.profit]),
  r.virtual && r.virtual.status,
]));

async function load() {
  const [sum, days, diary] = await Promise.all([
    fetch('/api/summary').then(x => x.ok ? x.json() : {}).catch(() => ({})),
    fetch('/api/days').then(x => x.ok ? x.json() : { days: [] }).catch(() => ({ days: [] })),
    fetch('/api/diary').then(x => x.ok ? x.json() : { journals: [] }).catch(() => ({ journals: [] })),
  ]);
  S.summary = sum;
  S.days = daysOf(days).sort((a, b) => a.date < b.date ? -1 : 1);
  S.journals = (diary.journals || []).sort((a, b) => a.date < b.date ? -1 : 1);
  const today = todayStr();
  S.cur = (S.days.find(d => d.date === today) || S.days[S.days.length - 1])?.date || '';
  if (!S.cur && S.journals.length) S.cur = S.journals[S.journals.length - 1].date;
  S._sumSig = sumSigOf(sum);
  S._daysSig = daysSigOf(S.days);
  renderStats();
  renderBetstop();
  if (S.days.length) await goDay(S.cur);
  else $('#daytable').innerHTML = `<div class="empty">${svg('chart', 30)}<span><b>暂无场次数据</b><br>刷新评分后即可看到当日竞彩场次</span></div>`;
  syncStatus();
}

/* 展示同步：只读新评分文件，不在浏览器里打分 */
async function syncStatus() {
  const st = await fetch('/api/score-status').then(x => x.ok ? x.json() : null).catch(() => null);
  const box = $('#srcerr');
  if (!box) return;
  if (st && st.ok === false && st.errors && st.errors.length) {
    box.classList.remove('hidden');
    box.innerHTML = `${svg('warn', 15)}<span>信息源错误：${esc(st.errors.map(e => (e.source || '') + ' ' + (e.message || '')).join('；'))}</span>`;
    return;
  }
  // 数据新鲜度：最新比赛日落后北京今天≥2天时提示（定时任务过期/抓取失败的可见信号）
  const h = await fetch('/api/health').then(x => x.ok ? x.json() : null).catch(() => null);
  const latest = h && h.latestDay;
  if (latest) {
    const bj = new Date(Date.now() + 8 * 3600_000).toISOString().slice(0, 10);
    const gap = Math.round((new Date(bj) - new Date(latest)) / 86400000);
    if (gap >= 2) {
      box.classList.remove('hidden');
      box.innerHTML = `${svg('warn', 15)}<span>数据已 ${gap} 天未更新（最新${esc(latest)}），请检查定时任务/执行一次刷新</span>`;
      return;
    }
  }
  box.classList.add('hidden');
}
let _syncing = false;
async function syncView() {
  if (document.hidden || !S.cur || _syncing) return;
  _syncing = true;
  try {
  const [sum, days, data] = await Promise.all([
    fetch('/api/summary').then(x => x.ok ? x.json() : S.summary).catch(() => S.summary),
    fetch('/api/days').then(x => x.ok ? x.json() : { days: S.days }).catch(() => ({ days: S.days })),
    fetch('/api/day/' + S.cur).then(x => x.ok ? x.json() : null).catch(() => null),
  ]);
  const newDays = daysOf(days) || S.days;
  // 未手动选日时跟着今天走（次日盘已开也不跳走）
  if (!S._picked && newDays.length) {
    const today = todayStr();
    if (newDays.some(d => d.date === today) && S.cur !== today) { goDay(today); return; }
  }
  const dSig = daysSigOf(newDays);
  const sSig = sumSigOf(sum);
  S.summary = sum;
  S.days = newDays;
  if (sSig !== S._sumSig) { S._sumSig = sSig; renderStats(); renderBetstop(); }
  if (dSig !== S._daysSig) { S._daysSig = dSig; renderChips(); }
  if (data) {
    const tSig = tableSigOf(data);
    if (tSig !== S._daySig) {
      S._daySig = tSig;
      S.day = data;
      S.scoreDay = loadDayScoreExists(S.cur);
      renderDayStat();
      renderFilter();
      renderTable();
      setTimeout(pollLive, 60); // 整表重绘后立即补一次实时比分，防止官方待开奖短暂覆盖
    }
  }
  syncStatus();
  } finally { _syncing = false; }
}
setInterval(syncView, 20000);

/* ===== 实时比分（每 5s 轮询，赛果列是唯一状态口） ===== */
function kickoffMs(m) {
  if (!m || !m.matchDate || !m.matchTime) return NaN;
  const t = String(m.matchTime).slice(0, 8);
  const hhmm = t.length === 5 ? t + ':00' : t;
  return new Date(`${m.matchDate}T${hhmm}+08:00`).getTime();
}
function matchStarted(r) {
  if (r.sealed || r.started) return true;
  const ms = kickoffMs(r.match);
  return Number.isFinite(ms) && Date.now() >= ms;
}
function liveCellHtml(score, status, started) {
  const sc = String(score || '').trim();
  const has = sc && sc !== '-' && sc !== ':';
  let st = String(status || '');
  if (st === '未开赛' || st === '已开售') st = '';
  if (has) return `<span class="res live">${esc(sc)}<i class="lk">${esc(st || '进行中')}</i></span>`;
  if (started) return `<span class="res wait">${svg('clock', 10)}待开奖</span>`;
  return `<span class="res">-</span>`;
}
let _liveTick = 0;
let _living = false;
async function pollLive() {
  if (document.hidden || !S.cur || !S.scoreDay || _living) return;
  _living = true;
  try {
  _liveTick++;
  const live = await fetch('/api/live/' + S.cur).then(x => x.ok ? x.json() : null).catch(() => null);
  const liveMap = (live && live.matches) || {};
  const rows = S.day.table || [];
  let touched = false;
  for (const r of rows) {
    if (r.result) continue;
    const tr = $('#daytable').querySelector('tr.mrow[data-num="' + r.num + '"]');
    if (!tr) continue;
    const target = tr.cells.length ? tr.cells[tr.cells.length - 1] : null;
    if (!target) continue;
    const lm = liveMap[String((r.match || {}).matchId || '')] || null;
    const started = matchStarted(r);
    const score = lm && (lm.score || (lm.okoo && lm.okoo.okScore));
    const status = (lm && (lm.statusName || (lm.okoo && lm.okoo.okStatusName))) || '';
    if (!score && !started) continue;
    const liveKey = (score || 'no') + '|' + (status || '') + (started ? '|1' : '');
    if (target.dataset.live === liveKey) continue;
    target.innerHTML = liveCellHtml(score, status, started);
    target.dataset.live = liveKey;
    touched = true;
  }
  // 每12轮（约60s）做一次整表对账，不依赖是否有比分变化，避免summary过期
  if (_liveTick % 12 === 0) syncView();
  } finally { _living = false; }
}
setInterval(pollLive, 5000);
// 切回页面立即同步一次（后台标签轮询被挂起，回到前台不用等下一个周期）
document.addEventListener('visibilitychange', () => { if (!document.hidden) { syncView(); pollLive(); } });

/* ===== 注单（置顶区块） ===== */
function betDate(b) {
  const s = b.placedAt || '';
  const m = String(s).match(/(\d{4})-(\d{2})-(\d{2})/);
  return m ? `${m[2]}-${m[3]}` : '';
}
function betNums(b) {
  return (b.legs || []).map(l => l.matchNum || '').filter(Boolean).join('×') || '-';
}
function betWhat(b) {
  return (b.legs || []).map(l => {
    const p = String(l.pick || '').replace(/\s*\([^)]*\)/g, '').trim();
    const vs = [l.home, l.away].filter(Boolean).join('vs');
    if (!p) return vs;
    if (vs && l.home && !p.includes(l.home) && !p.includes(l.away)) return vs + ' ' + p;
    return p;
  }).join(' × ');
}
function toggleBets() {
  S.betsOpen = !S.betsOpen;
  renderStats();
  renderBetstop();
}
/* 点弹窗外任意处 → 收起所有悬浮窗（手机无 hover，靠这个兜底） */
document.addEventListener('pointerdown', e => {
  if (!e.target || typeof e.target.closest !== 'function') return;
  if (!e.target.closest('.daybets')) $('#daybets')?.classList.remove('open');
  if (!e.target.closest('.stats-slot') && S.betsOpen) { S.betsOpen = false; renderStats(); renderBetstop(); }
});
function renderBetstop() {
  const el = $('#betstop');
  if (!el) return;
  el.classList.toggle('on', !!S.betsOpen);
  if (!S.betsOpen) { el.innerHTML = ''; return; }
  const bets = (S.summary.bets || []).filter(b =>
    b.betId != null && b.status !== 'void' && b.status !== 'cancelled'
  ).sort((a, b) => (b.betId || 0) - (a.betId || 0));
  if (!bets.length) { el.innerHTML = '<div class="empty" style="border:none;padding:16px;background:var(--bg1)"><span>暂无实单</span></div>'; return; }
  const rows = bets.map(b => {
    let cls = 'open', txt = '在途';
    if (b.status !== 'open') {
      const p = Number(b.profit);
      if (p > 0) { cls = 'win'; txt = '赢 +' + r2(p); }
      else if (p < 0) { cls = 'lose'; txt = '输 ' + r2(p); }
      else { cls = 'void'; txt = '走'; }
    }
    return `<tr class="${cls}"><td class="dt">${esc(betDate(b))}</td><td class="num">${esc(betNums(b))}</td><td class="leg">${esc(betWhat(b))}</td><td class="amt">${r2(b.stake)}</td><td><span class="bst ${cls}">${txt}</span></td></tr>`;
  }).join('');
  el.innerHTML = `<div class="bets-head">${svg('list', 14)}实单台账<span class="cnt">${bets.length} 单</span></div><div class="betlist-wrap"><table class="betlist"><thead><tr><th>日期</th><th>场次</th><th>买的</th><th>金额</th><th>结果</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}

/* ===== 顶栏账态 ===== */
function renderStats() {
  const L = S.summary.ledger || {};
  const bank = S.summary.bankroll || {};
  const cashV = L.cash ?? bank.cash ?? 0;
  const start = L.startBankroll || 1000;
  const profit = L.settledProfit ?? 0;
  const inPlay = (L.inPlay || []).length;
  const totalPortfolio = cashV + (L.inPlayAmount ?? 0);
  const pct = Math.max(0, Math.min(100, totalPortfolio / 10000 * 100));
  const mult = start ? totalPortfolio / start : 0;
  $('#stats').innerHTML = `
    <div class="st cash"><div class="k">现金可用</div><div class="v ${cashV >= start ? 'up' : 'down'}">¥${r2(cashV)}</div></div>
    <div class="st hide-sm"><div class="k">本金</div><div class="v">¥${start}</div></div>
    <div class="st"><div class="k">已结算盈亏</div><div class="v ${profit >= 0 ? 'up' : 'down'}">${profit >= 0 ? '+' : ''}${r2(profit)}</div></div>
    <div class="st"><div class="k">在途注单</div><div class="v wait">${inPlay} 单</div></div>
    <div class="st"><div class="k">体系总资产</div><div class="v model">¥${r2(totalPortfolio)}</div></div>
    <div class="st hide-sm"><div class="k">目标进度</div><div class="v wait">${mult.toFixed(2)}×</div></div>
    <div class="st hide-sm"><div class="k">距 ¥10000</div><div class="v">¥${(10000 - totalPortfolio).toFixed(0)}</div></div>
    <span class="caret${S.betsOpen ? ' on' : ''}">${svg('down', 14)}</span>`;
  const gp = $('#goalpct');
  if (gp) gp.style.width = pct + '%';
}

/* ===== 弹窗（日记 · 自我提升 / 评分说明） ===== */
function openModal(title, url) {
  $('#modal-title').innerHTML = title || `${svg('flask', 15)}日记 · 自我提升`;
  $('#modal-body').innerHTML = `<iframe class="panel" src="${url || 'self-upgrade.html'}?embed=1"></iframe>`;
  $('#modal-mask').classList.remove('hidden');
}
function openHelp() {
  openModal(`${svg('star', 15)}评分说明 · 六维怎么算`, 'help.html');
}
function closeModal(e) {
  if (e && e.target !== e.currentTarget) return;
  $('#modal-mask').classList.add('hidden');
}

/* ===== 每日列表 ===== */
function renderChips() {
  const today = todayStr();
  $('#daychips').innerHTML = S.days.map((d, i) => {
    const day = d.date.slice(5).replace('-', '/');
    const on = d.date === S.cur ? ' on' : '';
    const td = d.date === today ? '<span class="td">今</span>' : '';
    return `<div class="chip${on}${td ? ' has-td' : ''}" onclick="goDay('${d.date}', true)" style="--i:${Math.min(i, 14)}">${td}<b>${day}</b><span class="cnt">${d.matches}场</span></div>`;
  }).join('');
  const onEl = $('#daychips .chip.on');
  if (onEl) onEl.scrollIntoView({ inline: 'center', block: 'nearest' });
}

function dayMove(d) {
  const i = S.days.findIndex(x => x.date === S.cur);
  const j = Math.max(0, Math.min(S.days.length - 1, i + d));
  if (i !== j) goDay(S.days[j].date, true);
}

function skeletonHtml(cols) {
  const row = `<div class="sk-row">${Array.from({length: cols}).map(() => '<span></span>').join('')}</div>`;
  return `<div class="sk-head" style="height:36px;background:linear-gradient(90deg,var(--bg2),var(--bg3),var(--bg2));background-size:200% 100%;animation:shimmer 1.5s linear infinite"></div>${row.repeat(5)}<div class="sk-note">加载中…</div>`;
}

async function goDay(date, picked) {
  if (picked) S._picked = true; // 用户手动选择日期 → 停止自动跟随，尊重回看旧日期
  const prev = S.cur;
  S.cur = date;
  S.open = new Set();
  if (prev !== date) { S.minScore = 0; S.filterRec = false; }
  S.scoreDay = loadDayScoreExists(date);
  renderChips();
  $('#daytable').innerHTML = skeletonHtml(S.scoreDay ? 7 : 5);
  const data = await fetch('/api/day/' + date).then(x => x.ok ? x.json() : null).catch(() => null);
  if (!data) {
    $('#daytable').innerHTML = `<div class="empty">${svg('chart', 30)}<span><b>该日无数据</b><br>换一天看看</span></div>`;
    $('#daystat').innerHTML = '';
    const db = $('#daybets'); if (db) db.innerHTML = '';
    $('#filterbar').classList.add('hidden');
    return;
  }
  S.day = data;
  S._daySig = tableSigOf(data);
  renderDayStat();
  renderFilter();
  renderTable();
}

function rowBets(r) {
  const seen = new Set(), out = [];
  for (const b of (r.bets || [])) {
    if (b.betId == null || seen.has(b.betId)) continue;
    seen.add(b.betId); out.push(b);
  }
  return out;
}
function hasBet(r) { return rowBets(r).length > 0; }
function visibleRows() {
  const rows = (S.day.table || []);
  if (!S.scoreDay) return rows;
  if (S.filterRec) return rows.filter(hasBet);
  if (S.minScore <= 0) return rows;
  return rows.filter(r => r.score && r.score.total != null && r.score.total >= S.minScore);
}
function renderFilter() {
  const el = $('#filterbar');
  if (!el) return;
  if (!S.scoreDay) { el.classList.add('hidden'); return; }
  el.classList.remove('hidden');
  const opts = [{ v: 0, l: '全部' }, { v: 40, l: '40+' }, { v: 50, l: '50+' }, { v: 60, l: '60+' }, { v: 70, l: '70+' }, { v: 80, l: '80+' }, { v: 90, l: '90+' }];
  el.innerHTML = opts.map(o => {
      const on = !S.filterRec && S.minScore === o.v ? ' on' : '';
      const btn = `<button class="fbtn${on}" onclick="setMinScore(${o.v})" type="button">${o.l}</button>`;
      return o.v === 0 ? btn + `<button class="fbtn rec${S.filterRec ? ' on' : ''}" onclick="setFilterRec()" type="button">实单</button>` : btn;
    }).join('');
}
function setMinScore(v) { S.minScore = v; S.filterRec = false; renderFilter(); renderDayStat(); renderTable(); }
function setFilterRec() { S.filterRec = true; S.minScore = 0; renderFilter(); renderDayStat(); renderTable(); }

function shortLeg(l) {
  let s = String((l && l.pick) || '').replace(/\s*\([^)]*\)/g, '').trim();
  s = s.replace(/^竞彩(胜平负|让球胜负|比分|半全场|总进球)?\s*/, '');
  const om = s.match(/\s*@\s*([\d.]+)\s*$/);
  const odds = (l && l.odds) || (om ? om[1] : '');
  if (om) s = s.slice(0, om.index).trim();
  return { name: s, odds };
}
function betStatus(b) {
  if (b.status === 'open') return { cls: 'open', txt: '在途' };
  const p = Number(b.profit);
  if (p > 0) return { cls: 'win', txt: '+' + r2(p) };
  if (p < 0) return { cls: 'lose', txt: String(r2(p)) };
  return { cls: 'void', txt: '走' };
}
function renderDayBets() {
  const el = $('#daybets');
  if (!el) return;
  const items = [];
  const seen = new Set();
  for (const r of (S.day.table || [])) {
    for (const b of rowBets(r)) {
      if (seen.has(b.betId)) continue;
      seen.add(b.betId);
      items.push({ r, b });
    }
  }
  if (!items.length) { el.innerHTML = ''; return; }
  const rows = items.map(({ r, b }) => {
    const st = betStatus(b);
    const legs = (b.legs || []).map(shortLeg).filter(x => x.name);
    const name = legs.map(x => x.name).join(' × ') || ((r.match || {}).home || '');
    const odds = b.totalOdds || (legs.length === 1 ? legs[0].odds : '');
    return `<div class="item" onclick="event.stopPropagation();this.closest('.daybets').classList.remove('open');toggleRow('${r.num}')"><span class="num">${esc(r.num)}</span><span class="leg">${esc(name)}</span>${odds ? `<span class="od">${esc(odds)}</span>` : ''}<span class="amt">¥${r2(b.stake)}</span><span class="bst ${st.cls}">${st.txt}</span></div>`;
  }).join('');
  el.innerHTML = `<button class="db-trig" type="button" onclick="event.stopPropagation();this.parentElement.classList.toggle('open')">实单 <b>${items.length}</b></button><div class="db-drop">${rows}</div>`;
}
function betMarkHtml(row) {
  const bets = rowBets(row);
  if (!bets.length) return '';
  const stake = bets.reduce((s, b) => s + (Number(b.stake) || 0), 0);
  const open = bets.some(b => b.status === 'open');
  const win = bets.some(b => b.status !== 'open' && Number(b.profit) > 0);
  const lose = bets.some(b => b.status !== 'open' && Number(b.profit) < 0);
  const cls = open ? 'open' : win && !lose ? 'win' : lose && !win ? 'lose' : 'void';
  return `<span class="betmark ${cls}">实单 ¥${r2(stake)}</span>`;
}
function loadDayScoreExists(date) {
  const d = S.days.find(x => x.date === date);
  return !!(d && d.scoreFile);
}
function fmtBj(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  if (isNaN(d)) return '';
  try {
    return d.toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).replace(/\//g, '-');
  } catch { return ''; }
}

function renderDayStat() {
  const s = S.day.summary || {};
  const g = [];
  const push = (k, v, cls) => g.push(`<div class="ds${cls ? ' ' + cls : ''}"><div class="k">${k}</div><div class="v">${v}</div></div>`);
  const ver = S.day.scoreVersion ? `<i class="ver">${esc(S.day.scoreVersion)}</i>` : '';
  const n = s.total || 0;
  const scored = S.scoreDay ? s.scored : null;
  if (S.scoreDay && scored != null && scored !== n) push('', `${scored}/${n}场${ver}`);
  else push('', `${n}场${ver}`);
  if (S.scoreDay && s.best) {
    push('最高', `<a onclick="toggleRow('${s.best.num}')"><b>${s.best.total}</b> ${esc(s.best.num)} ${esc(s.best.home)}</a>`, 'best');
  }
  let yH = 0, yD = 0;
  for (const r of visibleRows()) { if (r.result && r.result.yellow) { yD++; if (r.result.yellowHit) yH++; } }
  if (S.scoreDay && yD) {
    const yPct = Math.round(yH / yD * 100);
    push('命中', `<span class="${yPct >= 60 ? 'win' : 'lose'}">${yH}/${yD} ${yPct}%</span>`);
  } else if (S.filterRec) {
    push('', '<i class="cand2">只看实单</i>');
  } else if (S.minScore > 0) {
    push('', `<i class="cand2">≥${S.minScore}分</i>`);
  }
  if (s.virtualOpen || s.virtualEnd) {
    push('虚', `<b class="wait">${s.virtualOpen || 0}</b>/${s.virtualEnd || 0}`);
  }
  const upd = fmtBj(S.day.scoreGeneratedAt);
  if (upd) push('更新', `<span title="评分生成时间（北京时间）">${upd}</span>`);
  $('#daystat').innerHTML = `<div class="ds-bar">${g.join('')}</div>`;
  renderDayBets();
}

function renderTable() {
  const scoreDay = S.scoreDay;
  const head = scoreDay ? ['场次','联赛','对阵','时间','方向@赔率','评分','赛果'] : ['场次','联赛','对阵','时间','盘口'];
  const rows = visibleRows();
  if (!rows.length) { $('#daytable').innerHTML = `<div class="empty">${svg('chart', 30)}<span><b>当日无竞彩场次</b><br>数据更新后再来看</span></div>`; return; }
  let h = `<table><thead><tr>${head.map(x => `<th>${x}</th>`).join('')}</tr></thead><tbody>`;
  rows.forEach((row, i) => { h += rowHtml(row).replace('<tr', `<tr style="--i:${Math.min(i, 14)}"`); });
  h += '</tbody></table>';
  if (scoreDay) h += `<div class="legend">评分 = 当日全表信息值（点击行展开看降水、模型、六维明细）</div>`;
  $('#daytable').innerHTML = h;
}

function rowHtml(row) {
  const m = row.match || {}, sc = row.score || null, v = row.virtual || null;
  const isOpen = S.open.has(row.num);
  const t = sc ? sc.total : null;
  const had = m.had || {}, hhad = m.hhad || {};
  // 实际下单盘口优先显示（保护盘/受让盘 vs 评分裸方向）——避免「裸方向≠实际所买」误导
  const tp = takenPos(row);
  const dirHtml = (S.scoreDay && sc && sc.dir)
    ? (tp
      ? `<div class="dir"><b>${esc(tp)}</b><span class="tag">${v && !rowBets(row).length ? '虚' : '实'}</span>${dropSig(sc)}</div>`
      : `<div class="dir"><b>${esc(shortDir(sc))}</b><span class="od">${sc.odds}</span>${dropSig(sc)}</div>`)
    : (had.h || hhad.h)
      ? `<div class="dir"><b>主 ${esc(had.h || '-')}</b><span class="od">客 ${esc(had.a || '-')}</span></div>${hhad.goalLine ? `<div class="drop quiet">让${esc(hhad.goalLine)}</div>` : ''}`
      : '<span class="drop quiet">未开盘</span>';
  const cel = scoreCell(sc, S.scoreDay);
  return `
    <tr class="mrow ${isOpen ? 'open' : ''}" data-num="${row.num}" onclick="toggleRow('${row.num}')">
      <td class="num">${esc(row.num)}</td>
      <td class="league">${esc(m.league || '')}</td>
      <td class="teams">${esc(m.home || '')}<span class="vs">vs</span>${esc(m.away || '')}</td>
      <td class="time">${esc((m.matchTime || '').slice(0, 5))}</td>
      <td class="dirtd">${dirHtml}</td>
      ${S.scoreDay ? `<td class="scrtd">${cel}</td>` : ''}
      ${S.scoreDay ? `<td>${hitHtml(row)}${betMarkHtml(row)}</td>` : ''}
    </tr>${isOpen ? detailRow(row) : ''}`;
}

/* 评分单元格：今日显示总分 + 六维细条；历史日不显示 */
function shortDir(sc) { return (sc && sc.dir) || ''; }
/* 实际下单盘口：优先真注 legs[0].pick，其次虚拟注 pick；无单返回 null */
function takenPos(row) {
  const rb = rowBets(row)[0];
  const src = (rb && rb.legs && rb.legs[0] && rb.legs[0].pick) || (row.virtual && row.virtual.pick) || '';
  if (!src) return null;
  return String(src).replace(/\s*\([^)]*\)/g, '').replace(/竞彩胜平负/g, '').replace(/\s+/g, ' ').trim();
}
/* 降水签名：并进方向行尾，不单独占一行；0.10 档才开始显示数字（更小的噪声不画） */
function dropSig(sc) {
  if (!sc || sc.total == null) return '';
  if (sc.hasBaseMark === '!' || sc.dropNote === '首盘') return '<span class="dropsig" title="首盘无基线，按基线计分">首盘</span>';
  if (typeof sc.dropAmt === 'number') {
    if (sc.dropAmt >= 0.1) return `<span class="dropsig up" title="降水">▼${sc.dropAmt.toFixed(2)}</span>`;
    if (sc.dropAmt <= -0.1) return `<span class="dropsig rose" title="升水">▲${Math.abs(sc.dropAmt).toFixed(2)}</span>`;
    return '<span class="dropsig quiet" title="盘口无变化">静</span>';
  }
  return '';
}
function hitHtml(row) {
  const r = row.result;
  if (r) return `<span class="res${r.hit ? ' hit' : ''}">${esc(r.text)}</span>`;
  const lv = row.live || {};
  return liveCellHtml(lv.score, lv.status, matchStarted(row));
}
function scoreCell(sc, scoreDay) {
  if (!scoreDay || !sc || sc.total == null) return '';
  const t = sc.total;
  const dm = dims(sc);
  const band = bandCls(t);
  const bars = dm.map((d, i) => {
    const r = Math.max(0, Math.min(1, d.val / d.max));
    const h = Math.round(r * 22);
    return `<i style="height:22px"><b style="height:${h}px;opacity:${0.25 + 0.75 * r};background:${DCOLS[i % DCOLS.length]}"></b></i>`;
  }).join('');
  return `<div class="scr-cell"><div class="scr-num ${band}">${t}</div><div class="scr-bars">${bars}</div></div>`;
}

function detailRow(row) {
  const m = row.match || {}, sc = row.score || null, v = row.virtual || null;
  const odds = (m.had || m.hhad)
    ? `<div class="odds-strip">${oddsRow('胜平负', m.had, sc && sc.base && sc.base.had)}${oddsRow('让球' + (m.hhad && m.hhad.goalLine ? ' ' + m.hhad.goalLine : ''), m.hhad, sc && sc.base && sc.base.hhad)}</div>`
    : '';
  let dimHtml = '';
  if (S.scoreDay && sc && sc.total != null) {
    const dm = dims(sc);
    dimHtml = `<div class="dims">${dm.map((d, i) => {
      const pct = Math.max(0, Math.min(100, (Number(d.val) / d.max) * 100));
      const col = DCOLS[i % DCOLS.length];
      return `<div class="dm" title="${esc(d.note || '')}"><div class="dk">${d.name}</div><div class="dv">${d.val}/${d.max}</div>
      <div class="bar" style="background:linear-gradient(90deg,${col} ${pct}%,rgba(145,164,204,.13) ${pct}%)"></div></div>`;
    }).join('')}</div>`;
  }
  let vb = '';
  if (v) {
    const st = v.status;
    const lost = st === 'lose' || st === 'loss';
    const stTxt = st === 'win' ? '中' : lost ? '败' : st === 'open' ? '在途' : (st || '');
    const stIcon = st === 'win' ? svg('check', 11) : lost ? svg('x', 11) : svg('clock', 11);
    vb = `<div class="vstrip"><div class="vh"><span>虚拟 ${esc(v.id || '')} · ${esc(v.pick || '')}</span><span class="num-mono" style="color:${st === 'win' ? 'var(--up)' : lost ? 'var(--down)' : 'var(--wait)'}">${stIcon} ${stTxt}${v.result ? ' · ' + esc(v.result) : ''}</span></div>
      <div class="anal">${esc(v.myView || '')}${v.analysis ? ' · ' + esc(v.analysis) : ''}</div>
      ${v.reviewHook ? `<div class="hook">${svg('clock', 10)} ${esc(v.reviewHook)}</div>` : ''}</div>`;
  }
  const band = (S.scoreDay && sc && sc.total != null)
    ? `<span class="band b-${bandCls(sc.total)}">${bandLabel(sc)}</span>` : '';
  const meta = `<div class="meta-line">${esc(row.num)}<span class="gap">·</span>${esc(m.league || '-')}<span class="gap">·</span>${esc(m.matchDate || '')} ${esc((m.matchTime || '').slice(0, 5))}${sc && sc.matchId ? '<span class="gap">·</span>' + esc(sc.matchId) : ''}${S.scoreDay && sc ? `<span class="gap">·</span><b>${esc(sc.dir)}@${sc.odds}</b> ${esc(sc.dropNote || '')} ${sc.total}分 ${band}` : ''}</div>`;
  const col = S.scoreDay ? 7 : 5;
  return `<tr class="detail"><td colspan="${col}"><div class="detail-box">${meta}${odds}${dimHtml}${vb}</div></td></tr>`;
}

function toggleRow(num) {
  // 只增/删被点行的详情行，不整表重绘（避免列表闪烁/动画重播）
  if (S.open.has(num)) S.open.delete(num); else S.open.add(num);
  const tr = $('#daytable tr.mrow[data-num="' + num + '"]');
  if (!tr) { S.open.delete(num); return; }
  const d = tr.nextElementSibling;
  const row = (S.day.table || []).find(r => r.num === num);
  if (S.open.has(num)) {
    tr.classList.add('open');
    if (row && !(d && d.classList.contains('detail'))) tr.insertAdjacentHTML('afterend', detailRow(row));
  } else {
    tr.classList.remove('open');
    if (d && d.classList.contains('detail')) d.remove();
  }
}

function oddsRow(name, now, base) {
  if (!now) return '';
  const cells = [['主', now.h, 'h'], ['平', now.d, 'd'], ['客', now.a, 'a']];
  let row = '<div class="odds3">';
  for (const [lbl, v, k] of cells) {
    const bv = base && base[k];
    let baseHtml = '';
    if (bv && v) {
      const d = +(parseFloat(bv) - parseFloat(v)).toFixed(2);
      if (d > 0) baseHtml = `<div class="base">${esc(bv)} <b class="hl">▼${d}</b></div>`;
      else if (d < 0) baseHtml = `<div class="base">${esc(bv)} <b class="hl-up">▲${Math.abs(d)}</b></div>`;
    }
    row += `<div class="ocell"><div class="lbl">${lbl}</div><div class="now">${esc(v || '-')}</div>${baseHtml}</div>`;
  }
  row += '</div>';
  return `<div class="odds-row"><span class="or-name">${esc(name)}</span>${row}</div>`;
}

/* ===== 日记已并入自我升级页 ===== */

/* html 转义（用于已含 html 的 dropNote 之外字段） */
function escapeHtmlC(s) { return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

/* 评分六维分解（v2.0：优先读 engine 落库的 dims JSONB，无则 v1.8 反推兜底） */
function dims(sc) {
  const d = sc.analysis && sc.analysis.dims;
  if (d && d.drop && d.model) {
    return [
      { name: '降水/变盘', val: d.drop.score, max: d.drop.max, note: d.drop.note },
      { name: '方向确认', val: d.confirm.score, max: d.confirm.max, note: d.confirm.note },
      { name: '模型命中', val: d.model.score, max: d.model.max, note: d.model.note },
      { name: '历史验证', val: d.history.score, max: d.history.max, note: d.history.note },
      { name: '风险排除', val: d.risk.score, max: d.risk.max, note: d.risk.note },
      { name: '赔率价值', val: d.value.score, max: d.value.max, note: d.value.note },
    ];
  }
  const dirPt = sc.confirm === 2 ? 8 : 4;
  const dropPart = sc.total - dirPt - (sc.model || 0) - (sc.history || 0) - (sc.risk || 0) - (sc.value || 0);
  return [
    { name: '降水/变盘', val: dropPart, max: 35 },
    { name: '方向确认', val: dirPt, max: 8 },
    { name: '模型命中', val: sc.model || 0, max: 20 },
    { name: '历史验证', val: sc.history || 0, max: 10 },
    { name: '风险排除', val: sc.risk || 0, max: 10 },
    { name: '赔率价值', val: sc.value || 0, max: 5 },
  ];
}

load();

/* ===== v2 WebSocket 实时同步（需求1）：服务器 push → 前端零刷新 ===== */
(function () {
  const WS = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws';
  let ws = null, retry = 3000, beat = 0;

  function applyDay(msg) {
    if (!msg.view || msg.date !== S.cur) return;
    const tSig = tableSigOf(msg.view);
    if (tSig === S._daySig) return;
    S._daySig = tSig;
    S.day = msg.view;
    S.scoreDay = loadDayScoreExists(S.cur);
    renderDayStat(); renderFilter(); renderTable();
    setTimeout(pollLive, 60);
  }
  function applySummary(msg) {
    if (!msg.summary) return;
    const sSig = sumSigOf(msg.summary);
    S.summary = msg.summary;
    if (sSig !== S._sumSig) { S._sumSig = sSig; renderStats(); renderBetstop(); }
  }
  function syncCur() {
    if (ws && ws.readyState === 1) {
      ws.send(JSON.stringify({ action: 'sub', rooms: ['day:' + S.cur, 'summary', 'status'] }));
    }
  }

  function connect() {
    try {
      const s = new WebSocket(WS);
      ws = s;
      s.onopen = () => { retry = 3000; syncCur(); };
      s.onmessage = e => {
        let m; try { m = JSON.parse(e.data); } catch { return; }
        if (m.type === 'day') applyDay(m);
        else if (m.type === 'summary') applySummary(m);
        else if (m.type === 'status') syncStatus();
      };
      s.onclose = () => { ws = null; setTimeout(connect, retry); retry = Math.min(retry * 2, 30000); };
      s.onerror = () => { try { s.close(); } catch {} };
    } catch { setTimeout(connect, retry); }
  }
  // S.cur 变化时（跨日/手动切日）自动重订
  let lastCur = null;
  setInterval(() => { if (S.cur !== lastCur) { lastCur = S.cur; syncCur(); } }, 1000);
  connect();
})();
</script>
