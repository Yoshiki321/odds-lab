const BN = { hammer:'加注', real:'实单', cand:'候选', weak:'弱', drop:'放弃' };
const bandCls = t => t >= 58 ? 'hammer' : t >= 48 ? 'real' : t >= 40 ? 'cand' : t >= 30 ? 'weak' : 'drop';
const bandLabel = sc => {
  let base = BN[bandCls(sc.total)];
  const b = sc.band || '';
