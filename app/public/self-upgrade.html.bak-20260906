<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>自我升级 · 竞彩助手</title>
<style>
:root{--bg:#0b0e14;--card:#141924;--border:#1e2538;--text:#e2e6f0;--dim:#5a6180;--green:#22c55e;--red:#ef4444;--yellow:#eab308;--blue:#3b82f6;--purple:#a78bfa}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--text);padding:32px;line-height:1.6}
.container{max-width:800px;margin:0 auto}
.back{margin-bottom:24px;font-size:13px}
.back a{color:var(--blue);text-decoration:none}
h1{font-size:20px;font-weight:700;margin-bottom:4px}
.sub{font-size:13px;color:var(--dim);margin-bottom:28px}
h2{font-size:15px;font-weight:600;margin:28px 0 12px;color:var(--text)}
h2 .c{background:var(--card);padding:1px 10px;border-radius:8px;font-size:11px;color:var(--dim);margin-left:8px;font-weight:400}
.rule{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:14px 16px;margin-bottom:8px;font-size:13px;display:flex;align-items:flex-start;gap:10px}
.rule .id{background:var(--bg);padding:2px 10px;border-radius:6px;font-size:11px;font-weight:600;color:var(--blue);flex-shrink:0;margin-top:1px}
.rule .new{background:rgba(167,139,250,0.15);color:var(--purple);padding:1px 6px;border-radius:4px;font-size:10px;margin-left:6px}
.mistake{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:14px 16px;margin-bottom:8px;font-size:13px}
.mistake .top{display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.mistake .id{font-weight:600;font-size:12px;color:var(--red)}
.mistake .type{background:rgba(239,68,68,0.1);color:var(--red);padding:1px 8px;border-radius:4px;font-size:11px}
.mistake .new{background:rgba(167,139,250,0.15);color:var(--purple);padding:1px 6px;border-radius:4px;font-size:10px}
.mistake .desc{color:var(--dim)}
.mistake .fix{margin-top:4px;color:var(--green);font-size:12px}
.mistake .count{background:var(--bg);padding:1px 8px;border-radius:4px;font-size:11px;color:var(--yellow)}
.check-item{display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--card);border:1px solid var(--border);border-radius:6px;margin-bottom:6px;font-size:13px}
.check-item .dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.check-item .dot.done{background:var(--green)}
.check-item .dot.new{background:var(--purple)}
.check-item .dot.stage{background:var(--blue)}
.check-item .stage-label{font-size:11px;color:var(--dim);background:var(--bg);padding:1px 8px;border-radius:4px;margin-right:4px}
.check-item .new{background:rgba(167,139,250,0.15);color:var(--purple);padding:1px 6px;border-radius:4px;font-size:10px;margin-left:6px}
/* 复盘区块 */
.postmortem{background:var(--card);border:1px solid var(--yellow);border-radius:12px;padding:20px;margin-bottom:14px}
.postmortem h3{font-size:14px;font-weight:600;margin-bottom:14px;color:var(--yellow)}
.pm-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--border)}
.pm-item:last-child{border-bottom:none}
.pm-item .icon{font-size:16px;flex-shrink:0;width:24px;text-align:center}
.pm-item .body{flex:1}
.pm-item .title{font-size:13px;font-weight:500;margin-bottom:2px}
.pm-item .detail{font-size:12px;color:var(--dim)}
.pm-item .tag{display:inline-block;padding:1px 8px;border-radius:4px;font-size:10px;margin-left:6px}
.tag-r{background:rgba(239,68,68,0.12);color:var(--red)}
.tag-g{background:rgba(34,197,94,0.12);color:var(--green)}
.tag-b{background:rgba(59,130,246,0.12);color:var(--blue)}
.footer{text-align:center;padding:24px 0;font-size:12px;color:var(--dim);border-top:1px solid var(--border);margin-top:32px}
.footer a{color:var(--blue);text-decoration:none}
</style>
</head>
<body>
<div class="container">
<div class="back"><a href="/">← 返回账单</a></div>
<h1>🧠 自我升级</h1>
<div class="sub">所有犯过的错误 → 提炼成规则 → 不再重复</div>
<div id="app"></div>
<div class="footer"><a href="/">← 返回账单</a></div>
</div>
<script>
const FALLBACK = {
  "rules": [
    { "id": "R1", "text": "官方API优先——赛果/战绩只来自 data/league 和 data/history，外部搜索只做背景，必须交叉验证" },
    { "id": "R2", "text": "赛季边界检查——2026-08月前的比赛是上赛季，不能当\"当前状态\"" },
    { "id": "R3", "text": "投注前验证 matchId——必须在赔率数据中核对场次信息一致" },
    { "id": "R4", "text": "8维分析框架——每场必须覆盖赔率变化/冷门价值/体力伤停/变盘信号" },
    { "id": "R5", "text": "时间窗口纪律——只投距开赛≥30分钟且≤8小时的比赛；超24小时不投。变盘≥3次才值得关注，但关注≠投注" },
    { "id": "R6", "text": "赛制认知——确认联赛是跨年(欧洲)还是自然年(巴甲/美职/日职)。自然年联赛写清当前轮次，不写\"首秀\"" }
  ],
  "mistakes": [
    { "id": "M001", "date": "2026-08-24", "type": "虚构赛果", "desc": "声称AC米兰2-0博洛尼亚——实际未赛，搜索引擎虚构数据", "fix": "赛果只从官方API获取，外部搜索只做背景，必须交叉验证", "count": 0 },
    { "id": "M002", "date": "2026-08-24", "type": "赛季混淆", "desc": "把2025-26赛季切尔西2-1热刺当成2026-27首轮", "fix": "分析前查联赛数据确认该队本赛季已赛场次，8月前的比赛是上赛季", "count": 0 },
    { "id": "M003", "date": "2026-08-24", "type": "matchId错配", "desc": "支持率数据的matchId与投注场次不一致，差点串错", "fix": "投注前必须在赔率数据中核对matchId对应的场次信息", "count": 0 },
    { "id": "M004", "date": "2026-08-24", "type": "分析维度不足", "desc": "仅用赔率快照5维，未追踪赔率变化/冷门价值/体力伤停/变盘信号", "fix": "每场强制8维分析框架，strategy.md v2", "count": 0 },
    { "id": "M005", "date": "2026-08-24", "type": "远期投注", "desc": "投了距开赛24-25小时的周一场次，分析仅基于当天盘面", "fix": "R5时间窗口纪律：只投距开赛≤8小时的场次", "count": 0 },
    { "id": "M006", "date": "2026-08-24", "type": "赛制认知错误", "desc": "把巴甲当跨年赛季首秀——实际自然年2026赛季已24轮", "fix": "R6赛制认知：自然年联赛写\"赛季第X轮\"，不写\"首秀\"", "count": 0 }
  ],
  "checklist": [
    { "item": "赛果/状态只来自官方API，不采信外部搜索的比分", "stage": "数据来源" },
    { "item": "确认当前是2026-27赛季，8月前的比赛是上赛季", "stage": "数据来源" },
    { "item": "★ 确认联赛赛制：跨年(欧洲)还是自然年(巴甲/美职/日职)；自然年联赛写清当前轮次", "stage": "数据来源", "isNew": true },
    { "item": "投注的matchId在赔率数据中核对过，场次信息一致", "stage": "数据来源" },
    { "item": "★ 赔率变化追踪：从开盘到临场的走势，变盘≥3次才值得关注", "stage": "分析" },
    { "item": "★ 变盘信号≠比赛结果：关注不等于投注，需结合其他维度判断", "stage": "分析", "isNew": true },
    { "item": "★ 冷门价值评估：热门过低(≤1.50)时主动评估冷门合理性", "stage": "分析" },
    { "item": "★ 体力/伤停：赛程密度(背靠背)、关键球员伤停、连续征战", "stage": "分析" },
    { "item": "★ 变盘监控：赔率单次变化≥5%时记录并重新评估", "stage": "分析" },
    { "item": "投注时间 < 开赛时间，且距开赛≥30分钟 且 ≤8小时；超24小时不投", "stage": "合规" },
    { "item": "单笔投注 ≤ 现金10%，单日累计 ≤ 现金30%", "stage": "资金" },
    { "item": "只做2串1，每腿只选一个结果", "stage": "资金" },
    { "item": "投后回读bet档案，验证matchId与赔率无误", "stage": "投后" }
  ]
};
async function main(){
  let data = FALLBACK;
  try{const r=await fetch('/api/mistakes');if(r.ok){const j=await r.json();if(j.rules||j.mistakes)data={...FALLBACK,...j}}}catch{}
  let h='';

  // 复盘 — bet-006
  h+=`<h2>📉 第3期复盘 · bet-006 全错</h2>`;
  h+=`<div class="postmortem">
    <div class="pm-item">
      <div class="icon">❌</div>
      <div class="body">
        <div class="title">bet-006 都灵让胜(1.91)×桑托斯主胜(1.66) 投100 <span class="tag tag-r">损失100</span></div>
        <div class="detail">结果：都灵1-2米兰（让球走水）· 桑托斯1-1米拉索尔（主胜输）。2串1全输。</div>
      </div>
    </div>
    <div class="pm-item">
      <div class="icon">1️⃣</div>
      <div class="body">
        <div class="title">理由1：都灵变盘信号7次，机构压主胜方向 <span class="tag tag-b">思路对但结果错</span></div>
        <div class="detail">变盘确认了资金流向，但资金流向≠赛果。米兰客场赢了。变盘信号是"关注场"不是"必投场"。</div>
      </div>
    </div>
    <div class="pm-item">
      <div class="icon">2️⃣</div>
      <div class="body">
        <div class="title">理由2：桑托斯主场首秀 <span class="tag tag-r">纯虚构</span></div>
        <div class="detail">巴甲是自然年2026赛季，已24轮。我写了"首秀"——这是没有任何官方数据支撑的虚构信息。M006已记录。</div>
      </div>
    </div>
    <div class="pm-item">
      <div class="icon">💡</div>
      <div class="body">
        <div class="title">核心反思：赔率合理性 VS 赛果确定性 <span class="tag tag-b">认知升级</span></div>
        <div class="detail">1.66的主胜赔率意味着机构认为桑托斯有60%胜率——但40%的输盘概率仍然很大。2串1中两腿各60%胜率 = 串关总胜率只有36%。低赔≠安全。</div>
      </div>
    </div>
    <div class="pm-item">
      <div class="icon">📊</div>
      <div class="body">
        <div class="title">数据：第3期结束，本金1000→900 <span class="tag tag-r">-10%</span></div>
        <div class="detail">1单2串1，100元，全输。累计6个错误（M001-M006），6条规则（R1-R6），14项核查清单。体系已建立，但认知还在补课。</div>
      </div>
    </div>
  </div>`;

  // rules
  h+=`<h2>📌 系统规则 <span class="c">${data.rules.length} 条</span></h2>`;
  data.rules.forEach(r=>{
    const isNew = r.id==='R5'||r.id==='R6';
    h+=`<div class="rule"><span class="id">${r.id}</span><span>${r.text}${isNew?'<span class="new">NEW</span>':''}</span></div>`;
  });
  // mistakes
  h+=`<h2>⚠️ 已记录错误 <span class="c">${data.mistakes.length} 条</span></h2>`;
  data.mistakes.forEach(m=>{
    const isNew = m.id==='M005'||m.id==='M006';
    h+=`<div class="mistake">
      <div class="top"><span class="id">${m.id}</span><span class="type">${m.type}</span>${isNew?'<span class="new">NEW</span>':''}<span class="desc" style="color:var(--dim);font-size:12px">${m.date}</span>${m.count>0?`<span class="count">复发 ${m.count}次</span>`:''}</div>
      <div class="desc">${m.desc}</div>
      <div class="fix">✅ ${m.fix}</div>
    </div>`;
  });
  // checklist
  h+=`<h2>📋 投前核查清单 <span class="c">${data.checklist.length} 项</span></h2>`;
  data.checklist.forEach(c=>{
    const dotClass = c.isNew ? 'new' : (c.stage === '资金' ? 'done' : 'stage');
    h+=`<div class="check-item"><span class="dot ${dotClass}"></span><span class="stage-label">${c.stage}</span><span>${c.item}${c.isNew?'<span class="new">NEW</span>':''}</span></div>`;
  });
  document.getElementById('app').innerHTML=h;
}
main()
</script>
</body>
</html>